{
  "name": "claude-usage-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live usage limits for every Claude account you track.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,cyan \"cross-env NO_OPEN=1 node --watch server/index.js\" \"cross-env NODE_ENV=development vite\"",
    "dev:mock": "cross-env MOCK=1 npm run dev",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage",
    "start": "node server/index.js",
    "start:mock": "cross-env MOCK=1 node server/index.js",
    "typecheck": "tsc --noEmit",
    "prestart": "node scripts/check-start.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/onest": "^5.3.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "classic-level": "^3.0.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0"
  },
  "packageManager": "npm@10.9.2"
}
